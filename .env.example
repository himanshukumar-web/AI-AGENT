# ── JARVIS AI — Environment Configuration ──
# Copy this file to .env and configure your preferences.
# Never commit your .env file containing real API keys to version control.

# ── General Settings ────────────────────────────────────────────────────────
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Sir
WAKE_WORDS=jarvis,hey jarvis,ok jarvis,okay jarvis,hello jarvis

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Provider options: auto, openai, gemini, ollama, groq
LLM_PROVIDER=auto

# Specific model override (optional, defaults to best per provider if blank)
# Examples: gpt-4o-mini, gemini-2.0-flash, llama-3.3-70b-versatile, llama3:latest
LLM_MODEL=

# LLM Routing mode: hybrid (fast tools local + complex LLM), fast_first, llm_only, offline_only
LLM_ROUTING_MODE=hybrid

# LLM Generation Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
ENABLE_STREAMING=true

# ── API Keys ────────────────────────────────────────────────────────────────
# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=

# Ollama Local Offline Server (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# OpenWeatherMap API key (https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=
WEATHER_CITY=New Delhi, India

# ── Memory & Safety ─────────────────────────────────────────────────────────
# Confirmation modes: ask_high_risk, strict, auto_allow
CONFIRMATION_MODE=ask_high_risk
MAX_CONTEXT_TURNS=10

# ── Text-To-Speech Settings ─────────────────────────────────────────────────
TTS_VOICE_RATE=180
TTS_VOICE_VOLUME=1.0
