# ── JARVIS AI — Environment Configuration ──
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# OpenWeatherMap API key (get one at https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your_api_key_here

# City for weather queries (format: "City, Country")
WEATHER_CITY=New Delhi, India

# User name for personalized greetings
JARVIS_USER_NAME=Sir
